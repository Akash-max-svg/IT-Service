    "vanta": "^0.5.24"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
