PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Atlas Connection String
# e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/servicedesk?retryWrites=true&w=majority
MONGODB_URI=

# Optional SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="IT Service Desk" <support@servicedesk.local>
